# --- API (apps/api) ---
# PostgreSQL connection string. For local development run `npm run db:local`
# (embedded PostgreSQL) and use the URL it prints, or point at any PostgreSQL 14+ server.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/orbit
PORT=3001
# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty when the web app and API share an origin (Vite proxy / single Vercel project).
CORS_ORIGIN=
# Max pooled PostgreSQL connections per process (defaults: 5 locally, 1 on Vercel).
# PG_POOL_MAX=

# --- Web (apps/web) ---
# Base URL of the API. Leave empty to use same-origin relative `/api` requests.
VITE_API_BASE_URL=
